{
  "schemaVersion": 1,
  "id": "quickskin",
  "version": "${version}",
  "name": "QuickSkin",
  "description": "QuickSkin - Customize your Minecraft player skin and cape in-game! Supports both Fabric and Forge through Architectury.",
  "authors": [
    "The Plum Team"
  ],
  "contact": {
    "homepage": "https://github.com/yourusername/quickskin",
    "sources": "https://github.com/yourusername/quickskin",
    "issues": "https://github.com/yourusername/quickskin/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.quickskin.mod.fabric.QuickSkinFabric"
    ],
    "client": [
      "com.quickskin.mod.fabric.QuickSkinFabricClient"
    ]
  },
  "mixins": [
    "quickskin.mixins.json",
    "quickskin-ears.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "=1.21.1",
    "architectury": ">=13.0.0"
  },
  "suggests": {
    "another-mod": "*"
  }
}
